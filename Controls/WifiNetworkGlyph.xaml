<UserControl x:Class="WindowsLive.Controls.WifiNetworkGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="17"
             Height="17"
             SnapsToDevicePixels="True">
    <Grid>
        <Image x:Name="WifiIcon"
               Source="pack://application:,,,/Resources/wifi_icon.png"
               Width="16" Height="14"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Image x:Name="HotspotIcon"
               Source="pack://application:,,,/Resources/hotspot_icon_blue.png"
               Width="16" Height="14"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
</UserControl>
