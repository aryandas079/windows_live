<Window x:Class="WindowsLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:WindowsLive.Controls"
        mc:Ignorable="d"
        Title=""
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="700" Height="260"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <Grid x:Name="RootGrid" Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Center">
        <!-- Top Edge Hover Zone for Maximized & Fullscreen Apps -->
        <Border x:Name="TopEdgeHotspot"
                Height="12"
                Width="340"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Background="#01000000"
                MouseEnter="TopEdgeHotspot_MouseEnter" />

        <!-- Island Container -->
        <Grid x:Name="IslandContainer"
              Width="160" Height="36"
              VerticalAlignment="Top"
              HorizontalAlignment="Center"
              AllowDrop="True"
              PreviewDragEnter="IslandContainer_PreviewDragEnter"
              PreviewDragOver="IslandContainer_PreviewDragOver"
              PreviewDrop="IslandContainer_PreviewDrop"
              QueryContinueDrag="IslandContainer_QueryContinueDrag"
              Cursor="Arrow">

            <!-- Ambient Glow / Drop Shadow Layer -->
            <controls:DynamicIslandNotch x:Name="IslandShadow"
                                         IsNotchMode="True"
                                         EarFillet="12"
                                         CornerRadius="16"
                                         Fill="#000000"
                                         StrokeThickness="0">
                <controls:DynamicIslandNotch.Effect>
                    <DropShadowEffect x:Name="IslandShadowEffect" Color="#000000" BlurRadius="18" Opacity="0.45" ShadowDepth="3" Direction="270" />
                </controls:DynamicIslandNotch.Effect>
            </controls:DynamicIslandNotch>

            <!-- Base Dock Surface (Follows System Light/Dark Theme & Solid Opaque) -->
            <controls:DynamicIslandNotch x:Name="IslandNotch"
                                         IsNotchMode="True"
                                         EarFillet="12"
                                         CornerRadius="16"
                                         Fill="{DynamicResource SurfaceDarkBrush}"
                                         Stroke="{DynamicResource SurfaceBorderBrush}"
                                         StrokeThickness="1" />

            <!-- ============================================== -->
            <!-- COMPACT VIEW (Idle / Collapsed State)          -->
            <!-- ============================================== -->
            <Grid x:Name="CompactView"
                  Height="36"
                  VerticalAlignment="Top"
                  Margin="12,0,12,0"
                  Opacity="1.0"
                  ClipToBounds="True">

                <!-- 1. Default Mode: Clock & Date (Hidden by default for empty blank notch) -->
                <Grid x:Name="CompactClockView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Cursor="Hand"
                      MouseDown="CompactClockView_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CompactTimeText"
                               Grid.Column="0"
                               Text="2:15 PM"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <Ellipse Grid.Column="1"
                             Width="3" Height="3"
                             Fill="{DynamicResource TextSecondaryBrush}"
                             Opacity="0.6"
                             Margin="7,0,7,0"
                             VerticalAlignment="Center" />

                    <TextBlock x:Name="CompactDateText"
                               Grid.Column="2"
                               Text="Sat, Nov 14"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <!-- Green Charging Pill next to clock when plugged in -->
                    <Border x:Name="CompactChargingPill"
                            Grid.Column="3"
                            Visibility="Collapsed"
                            Background="#1A30D158"
                            BorderBrush="#4030D158"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="5,1.5,5,1.5"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseDown="CompactChargingPill_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="10" Foreground="#30D158" Margin="0,0,2.5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompactBatteryPercentText" Text="85%" FontSize="11" FontWeight="SemiBold" Foreground="#30D158" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Orange Moon Crescent Pill for Night Mode -->
                    <Border x:Name="CompactNightModePill"
                            Grid.Column="4"
                            Visibility="Collapsed"
                            Background="#1AFF9F0A"
                            BorderBrush="#40FF9F0A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="5,1.5,5,1.5"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip="Night Mode is On (Click to open settings)"
                            MouseDown="CompactNightModePill_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,3,0">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="#FF9F0A"
                                          Data="M 12.3,10.2 C 7.5,10.2 3.6,6.3 3.6,1.5 C 3.6,1.0 3.7,0.5 3.8,0 C 1.5,1.2 0,3.6 0,6.4 C 0,10.5 3.3,13.8 7.4,13.8 C 10.2,13.8 12.6,12.3 13.8,10.0 C 13.3,10.1 12.8,10.2 12.3,10.2 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Night" FontSize="11" FontWeight="SemiBold" Foreground="#FF9F0A" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Column 5: Privacy Indicators in Clock View (Camera Green, Mic Orange) -->
                    <StackPanel x:Name="ClockPrivacyPanel"
                                Grid.Column="5"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0"
                                Visibility="Collapsed">
                        <Border x:Name="ClockCameraDot"
                                Width="7.5" Height="7.5"
                                CornerRadius="3.75"
                                Background="#30D158"
                                Margin="2,0,2,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect Color="#30D158" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ClockMicDot"
                                Width="7.5" Height="7.5"
                                CornerRadius="3.75"
                                Background="#FF9F0A"
                                Margin="2,0,2,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF9F0A" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                            </Border.Effect>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 2. Media Mode: Matches Image 3 (disc icon left, animated equalizer right) -->
                <Grid x:Name="CompactMediaView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Rounded Album Art / Thumbnail safely inset inside notch -->
                    <Border Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="6"
                            Background="{DynamicResource CardBackgroundBrush}"
                            VerticalAlignment="Center">
                        <Grid>
                            <Ellipse x:Name="CompactDefaultOrb" Fill="{DynamicResource AccentColorBrush}" />
                            <Image x:Name="CompactAlbumImage" Stretch="UniformToFill" Visibility="Collapsed">
                                <Image.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Width="24" Height="24" CornerRadius="6" Background="Black" />
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Image.OpacityMask>
                            </Image>
                            <ui:SymbolIcon x:Name="CompactOrbSymbol" Symbol="MusicNote224" FontSize="11" Foreground="{DynamicResource PlayButtonForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Center: Spacious Island Gap -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Animated Accent Equalizer, Night Mode indicator, and Privacy Indicators -->
                    <!-- Equalizer shifts to the left when Privacy Indicators (Camera Green, Mic Orange) are active -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                        <Viewbox x:Name="CompactMediaNightMoon" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed">
                            <Canvas Width="16" Height="16">
                                <Path Fill="#FF9F0A" Data="M 12.3,10.2 C 7.5,10.2 3.6,6.3 3.6,1.5 C 3.6,1.0 3.7,0.5 3.8,0 C 1.5,1.2 0,3.6 0,6.4 C 0,10.5 3.3,13.8 7.4,13.8 C 10.2,13.8 12.6,12.3 13.8,10.0 C 13.3,10.1 12.8,10.2 12.3,10.2 Z" />
                            </Canvas>
                        </Viewbox>
                        <controls:EqualizerControl x:Name="CompactEqualizer"
                                                   VerticalAlignment="Center"
                                                   AccentBrush="{DynamicResource AccentColorBrush}"
                                                   IsPlaying="True" />
                        <!-- Privacy Indicator Dots (Camera Green, Microphone Orange) positioned to the right of Equalizer -->
                        <StackPanel x:Name="MediaPrivacyPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Cursor="Hand"
                                    ToolTip="Privacy Indicators (Click to cycle simulation)"
                                    MouseDown="MediaPrivacyPanel_MouseDown"
                                    Visibility="Collapsed">
                            <!-- Camera Green Dot -->
                            <Border x:Name="MediaCameraDot"
                                    Width="7.5" Height="7.5"
                                    CornerRadius="3.75"
                                    Background="#30D158"
                                    Margin="2,0,2,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#30D158" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                            <!-- Microphone Orange Dot -->
                            <Border x:Name="MediaMicDot"
                                    Width="7.5" Height="7.5"
                                    CornerRadius="3.75"
                                    Background="#FF9F0A"
                                    Margin="2,0,2,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF9F0A" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                            <!-- Recording status is grouped with the system activity dots. -->
                            <Ellipse x:Name="CompactRecordingActivityDot"
                                     Width="7.5" Height="7.5"
                                     Fill="#FF453A"
                                     Margin="2,0,2,0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FF453A" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </StackPanel>
                        <controls:WifiNetworkGlyph x:Name="MediaWifiStatusGlyph"
                                                   Width="16" Height="16"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- 3. Charging & Battery Alerts: Matches Image ("Low Battery", "Unplugged", "Power Saver", "Charging") -->
                <Grid x:Name="CompactChargingView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="12,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Alert Title (e.g. "Low Battery", "Charging", "Unplugged", "Power Saver") in clean bold font -->
                    <TextBlock x:Name="CompactBatteryAlertTitle"
                               Grid.Column="0"
                               Text="Low Battery"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="2,0,0,0" />

                    <!-- Center: Spacious camera notch gap -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Percentage & Apple-Style Clean Battery Capsule -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                        <TextBlock x:Name="CompactChargingText"
                                   Text="20%"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FF453A"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />

                        <!-- Apple Battery Icon matching Image -->
                        <Grid VerticalAlignment="Center">
                            <!-- Unfilled / Background Capsule -->
                            <Border x:Name="CompactChargingBatteryBack"
                                    Width="33" Height="16"
                                    CornerRadius="4.5"
                                    Background="#351616"
                                    BorderBrush="#502424"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <!-- Filled Level -->
                                <Border x:Name="CompactChargingBatteryFill"
                                        Width="20" Height="14"
                                        CornerRadius="3.5"
                                        Background="#FF453A"
                                        HorizontalAlignment="Left" />
                            </Border>
                            <!-- Battery Terminal Cap / Nub -->
                            <Border x:Name="CompactChargingBatteryCap"
                                    Width="2.5" Height="6"
                                    CornerRadius="0,1.5,1.5,0"
                                    Background="#502424"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,-3,0"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 4. Notification Mode: Matches Image (App icon on left, "1" on right) -->
                <Grid x:Name="CompactNotificationView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      Cursor="Hand"
                      MouseDown="CompactNotificationView_MouseDown"
                      Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: App Icon / Badge -->
                    <controls:AppIconControl x:Name="CompactNotifIcon"
                                             Grid.Column="0"
                                             Width="26" Height="26"
                                             CornerRadius="7"
                                             IconPadding="4"
                                             VerticalAlignment="Center"
                                             Margin="4,0,0,0" />

                    <!-- Center: black notch surface -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Number "1" (Clean white font) -->
                    <TextBlock x:Name="CompactNotifCountText"
                               Grid.Column="2"
                               Text="1"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                </Grid>

                <!-- 5. Device Lock & Unlock Mode (Matches Reference Images media_1794722062518_8479b98f.png & media_1794722073217_776a4e86.png) -->
                <Grid x:Name="CompactUnlockView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="16,0,16,0">
                    <!-- Left-aligned clean minimalist padlock icon matching reference images exactly -->
                    <Viewbox Width="17" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Canvas Width="22" Height="26">
                            <!-- Padlock Body: Rounded rectangle with smooth corners -->
                            <Rectangle Canvas.Left="2.5" Canvas.Top="11"
                                       Width="17" Height="13"
                                       RadiusX="3.5" RadiusY="3.5"
                                       Fill="White" />

                            <!-- Shackle: Clean arch with pivot on the left leg (X=6.5, Y=11) -->
                            <Canvas x:Name="LockShackleContainer" Width="22" Height="26" Canvas.Left="0" Canvas.Top="0"
                                    RenderTransformOrigin="0.295,0.423">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="LockShackleTranslate" X="0" Y="0" />
                                        <RotateTransform x:Name="LockShackleRotate" Angle="0" />
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Path Stroke="White"
                                      StrokeThickness="2.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 6.5,12.5 V 6.5 C 6.5,3.8 8.4,2.0 11.0,2.0 C 13.6,2.0 15.5,3.8 15.5,6.5 V 12.5" />
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                </Grid>

                <!-- 6. Silent / Ring Alert Mode (Matches User Uploaded Image 1 & 2) -->
                <Grid x:Name="CompactSilentRingView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="4,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Coral/Red Capsule for Silent OR White Bell for Ring -->
                    <Border x:Name="CompactSilentBadge"
                            Grid.Column="0"
                            Width="46" Height="26"
                            CornerRadius="13"
                            Background="#FF453A"
                            VerticalAlignment="Center">
                        <!-- Muted Bell Icon with Diagonal Strike Line -->
                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Bell -->
                            <Path Fill="White"
                                  Data="M 8,2 C 6.34,2 5,3.34 5,5 V 7.8 L 3.5,10.3 C 3.2,10.8 3.55,11.5 4.15,11.5 H 11.85 C 12.45,11.5 12.8,10.8 12.5,10.3 L 11,7.8 V 5 C 11,3.34 9.66,2 8,2 Z M 6.5,12.5 C 6.5,13.33 7.17,14 8,14 C 8.83,14 9.5,13.33 9.5,12.5 Z" />
                            <!-- Diagonal Strike Line -->
                            <Line X1="2" Y1="14" X2="14" Y2="2"
                                  Stroke="#FF453A" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="2" Y1="14" X2="14" Y2="2"
                                  Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Border>

                    <!-- Alternate Ring Icon (White unmuted bell) -->
                    <Border x:Name="CompactRingBadge"
                            Grid.Column="0"
                            Width="26" Height="26"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Crisp White Bell -->
                            <Path Fill="White"
                                  Data="M 9,1.5 C 6.8,1.5 5,3.3 5,5.5 V 8.8 L 3.3,11.7 C 2.9,12.4 3.4,13.2 4.2,13.2 H 13.8 C 14.6,13.2 15.1,12.4 14.7,11.7 L 13,8.8 V 5.5 C 13,3.3 11.2,1.5 9,1.5 Z M 7.2,14.5 C 7.2,15.5 8.0,16.2 9,16.2 C 10.0,16.2 10.8,15.5 10.8,14.5 Z" />
                        </Canvas>
                    </Border>

                    <!-- Center: Notch Space -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Text "Silent" (in #FF453A) or "Ring" (in White) -->
                    <TextBlock x:Name="CompactSilentRingText"
                               Grid.Column="2"
                               Text="Silent"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="#FF453A"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0" />
                </Grid>

                <!-- 7. Focus / Do Not Disturb (DND) Alert Mode -->
                <Grid x:Name="CompactDndView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="4,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Purple Moon / DND Capsule Badge -->
                    <Border x:Name="CompactDndBadge"
                            Grid.Column="0"
                            Width="46" Height="26"
                            CornerRadius="13"
                            Background="#AF52DE"
                            VerticalAlignment="Center">
                        <!-- Crescent Moon Icon -->
                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="White"
                                  Data="M 12.3,10.2 C 7.5,10.2 3.6,6.3 3.6,1.5 C 3.6,1.0 3.7,0.5 3.8,0 C 1.5,1.2 0,3.6 0,6.4 C 0,10.5 3.3,13.8 7.4,13.8 C 10.2,13.8 12.6,12.3 13.8,10.0 C 13.3,10.1 12.8,10.2 12.3,10.2 Z" />
                        </Canvas>
                    </Border>

                    <!-- Center: Notch Space -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Text "Do Not Disturb" (in #AF52DE) -->
                    <TextBlock x:Name="CompactDndText"
                               Grid.Column="2"
                               Text="Do Not Disturb"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#AF52DE"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0" />
                </Grid>

                <!-- 8. Live Active Timer Pill (Matches User Uploaded Reference Exactly) -->
                <!-- Amber circle pause button, subtle dark cancel (X) button, and amber Timer mm:ss text -->
                <Grid x:Name="CompactLiveTimerView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="6,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Control Buttons Group -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Amber Circular Pause / Resume Button -->
                        <Button x:Name="CompactTimerPauseBtn"
                                Width="28" Height="28"
                                Margin="0,0,6,0"
                                Padding="0"
                                Background="#382500"
                                BorderBrush="#6B4800"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="CompactTimerPauseBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="PBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="PBorder" Property="Background" Value="#4D3300" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="PBorder" Property="Background" Value="#291A00" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Canvas Width="10" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Amber Pause Bars (or Play Triangle) -->
                                <Rectangle x:Name="CompactTimerPauseBar1" Width="3" Height="11" Canvas.Left="0" Canvas.Top="0.5" RadiusX="1" RadiusY="1" Fill="#F59E0B" />
                                <Rectangle x:Name="CompactTimerPauseBar2" Width="3" Height="11" Canvas.Left="7" Canvas.Top="0.5" RadiusX="1" RadiusY="1" Fill="#F59E0B" />
                                <Path x:Name="CompactTimerPlayTriangle" Data="M 1,0.5 L 9,6 L 1,11.5 Z" Fill="#F59E0B" Visibility="Collapsed" />
                            </Canvas>
                        </Button>

                        <!-- Dark Circular Close / Cancel Button (X) -->
                        <Button x:Name="CompactTimerCancelBtn"
                                Width="28" Height="28"
                                Padding="0"
                                Background="#1A1A1E"
                                BorderBrush="#2C2C30"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="CompactTimerCancelBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="14">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CBorder" Property="Background" Value="#2A2A30" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="CBorder" Property="Background" Value="#101014" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Canvas Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Clean Crisp White 'X' -->
                                <Line X1="1" Y1="1" X2="9" Y2="9" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="9" Y1="1" X2="1" Y2="9" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Button>
                    </StackPanel>

                    <!-- Center: Notch Space -->
                    <Grid Grid.Column="1" />

                    <!-- Right: "Timer mm:ss" in Vibrant iOS Amber (#F59E0B) and Privacy Indicators -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Viewbox x:Name="CompactTimerNightMoon" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed">
                            <Canvas Width="16" Height="16">
                                <Path Fill="#FF9F0A" Data="M 12.3,10.2 C 7.5,10.2 3.6,6.3 3.6,1.5 C 3.6,1.0 3.7,0.5 3.8,0 C 1.5,1.2 0,3.6 0,6.4 C 0,10.5 3.3,13.8 7.4,13.8 C 10.2,13.8 12.6,12.3 13.8,10.0 C 13.3,10.1 12.8,10.2 12.3,10.2 Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Timer "
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#F59E0B"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactLiveTimerCountdownText"
                                   Text="0:58"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#F59E0B"
                                   VerticalAlignment="Center" />
                        <!-- Privacy Indicator Dots -->
                        <StackPanel x:Name="TimerPrivacyPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed">
                            <Border x:Name="TimerCameraDot"
                                    Width="7.5" Height="7.5"
                                    CornerRadius="3.75"
                                    Background="#30D158"
                                    Margin="2,0,2,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#30D158" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="TimerMicDot"
                                    Width="7.5" Height="7.5"
                                    CornerRadius="3.75"
                                    Background="#FF9F0A"
                                    Margin="2,0,2,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF9F0A" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                        </StackPanel>
                        <controls:WifiNetworkGlyph x:Name="TimerWifiStatusGlyph"
                                                   Width="16" Height="16"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- 9. Split Leading Bubble: Compact Music View (Shown when Timer + Music are both active) -->
                <!-- Shows rounded album artwork on the left and live pulsing equalizer on the right -->
                <Grid x:Name="SplitLeadingMediaView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Rounded Album Artwork / Thumbnail -->
                    <Border Grid.Column="0"
                            Width="22" Height="22"
                            CornerRadius="6"
                            Background="{DynamicResource CardBackgroundBrush}"
                            VerticalAlignment="Center">
                        <Grid>
                            <Ellipse x:Name="SplitDefaultOrb" Fill="{DynamicResource AccentColorBrush}" />
                            <Image x:Name="SplitAlbumImage" Stretch="UniformToFill" Visibility="Collapsed">
                                <Image.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Width="22" Height="22" CornerRadius="6" Background="Black" />
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Image.OpacityMask>
                            </Image>
                            <ui:SymbolIcon x:Name="SplitOrbSymbol" Symbol="MusicNote224" FontSize="10" Foreground="{DynamicResource PlayButtonForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Center Gap -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Animated Accent Equalizer Waveform and Privacy Indicators -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                        <controls:EqualizerControl x:Name="SplitEqualizer"
                                                   VerticalAlignment="Center"
                                                   AccentBrush="{DynamicResource AccentColorBrush}"
                                                   IsPlaying="True" />
                        <StackPanel x:Name="SplitPrivacyPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed">
                            <Border x:Name="SplitCameraDot"
                                    Width="7.5" Height="7.5"
                                    CornerRadius="3.75"
                                    Background="#30D158"
                                    Margin="2,0,2,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#30D158" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="SplitMicDot"
                                    Width="7.5" Height="7.5"
                                    CornerRadius="3.75"
                                    Background="#FF9F0A"
                                    Margin="2,0,2,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF9F0A" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 10. Live Call / Audio Call Pill (Matches User Uploaded Reference media_1794722326989_0583e504.png) -->
                <!-- Left: Green Telephone Handset Icon (#30D158) + Call Duration in #30D158 -->
                <!-- Center: Camera Notch Space -->
                <!-- Right: Active Call Waveform Bars in #30D158 + Privacy Indicators -->
                <Grid x:Name="CompactVoiceRecordingView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="12,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Call Icon (Green) or Sound Recording Icon (Red) + Duration Timer (e.g. 00:03) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Apple-style Call Telephone Handset Vector Icon in #30D158 (Visible only for calls) -->
                        <Viewbox x:Name="CompactCallIcon" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#30D158"
                                      Data="M 6.62,10.79 C 8.06,13.62 10.38,15.94 13.21,17.38 L 15.41,15.18 C 15.69,14.9 16.08,14.82 16.43,14.93 C 17.55,15.3 18.75,15.5 20,15.5 C 20.55,15.5 21,15.95 21,16.5 L 21,20 C 21,20.55 20.55,21 20,21 C 10.61,21 3,13.39 3,4 C 3,3.45 3.45,3 4,3 L 7.5,3 C 8.05,3 8.5,3.45 8.5,4 C 8.5,5.25 8.7,6.45 9.07,7.57 C 9.18,7.92 9.1,8.31 8.82,8.59 L 6.62,10.79 Z" />
                            </Canvas>
                        </Viewbox>

                        <!-- Apple-style Voice / Sound Recording Microphone Vector Icon in #FF453A (Visible only for recording) -->
                        <Viewbox x:Name="CompactRecordingMicIcon" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Visible">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#FF453A"
                                      Data="M 12,14 C 13.66,14 15,12.66 15,11 L 15,5 C 15,3.34 13.66,2 12,2 C 10.34,2 9,3.34 9,5 L 9,11 C 9,12.66 10.34,14 12,14 Z M 19,10 C 19,13.53 16.39,16.44 13,16.93 L 13,20 L 16,20 C 16.55,20 17,20.45 17,21 C 17,21.55 16.55,22 16,22 L 8,22 C 7.45,22 7,21.55 7,21 C 7,20.45 7.45,20 8,20 L 11,20 L 11,16.93 C 7.61,16.44 5,13.53 5,10 C 5,9.45 5.45,9 6,9 C 6.55,9 7,9.45 7,10 C 7,12.76 9.24,15 12,15 C 14.76,15 17,12.76 17,10 C 17,9.45 17.45,9 18,9 C 18.55,9 19,9.45 19,10 Z" />
                            </Canvas>
                        </Viewbox>

                        <TextBlock x:Name="CompactRecordingDurationText"
                                   Text="00:00"
                                   FontSize="16.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FF453A"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center: Notch Space -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Dynamic Live Audio Call Waveform Bars in #FF453A / #30D158 and Privacy Indicators -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="RecordingWaveformBars"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border x:Name="RecBar1" Width="2.8" Height="4" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar2" Width="2.8" Height="8" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar3" Width="2.8" Height="14" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar4" Width="2.8" Height="12" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar5" Width="2.8" Height="6" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar6" Width="2.8" Height="13" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar7" Width="2.8" Height="16" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar8" Width="2.8" Height="12" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar9" Width="2.8" Height="8" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar10" Width="2.8" Height="4" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar11" Width="2.8" Height="7" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar12" Width="2.8" Height="11" CornerRadius="1.4" Background="#FF453A" Margin="0,0,2.2,0" VerticalAlignment="Center" />
                            <Border x:Name="RecBar13" Width="2.8" Height="4" CornerRadius="1.4" Background="#FF453A" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="VoicePrivacyPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed">
                            <Border x:Name="VoiceCameraDot"
                                    Width="7.5" Height="7.5"
                                    CornerRadius="3.75"
                                    Background="#30D158"
                                    Margin="2,0,2,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#30D158" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="VoiceMicDot"
                                    Width="7.5" Height="7.5"
                                    CornerRadius="3.75"
                                    Background="#FF9F0A"
                                    Margin="2,0,2,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF9F0A" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                        </StackPanel>
                        <controls:WifiNetworkGlyph x:Name="VoiceWifiStatusGlyph"
                                                   Width="16" Height="16"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <!-- 10.5. Incoming Call Compact View: Apple Dynamic Island Ringing State -->
                <Grid x:Name="CompactIncomingCallView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Pulsing Green Phone Handset + Caller Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox x:Name="CompactIncomingPhoneIcon" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#30D158"
                                      Data="M 6.62,10.79 C 8.06,13.62 10.38,15.94 13.21,17.38 L 15.41,15.18 C 15.69,14.9 16.08,14.82 16.43,14.93 C 17.55,15.3 18.75,15.5 20,15.5 C 20.55,15.5 21,15.95 21,16.5 L 21,20 C 21,20.55 20.55,21 20,21 C 10.61,21 3,13.39 3,4 C 3,3.45 3.45,3 4,3 L 7.5,3 C 8.05,3 8.5,3.45 8.5,4 C 8.5,5.25 8.7,6.45 9.07,7.57 C 9.18,7.92 9.1,8.31 8.82,8.59 L 6.62,10.79 Z" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="CompactIncomingCallerText"
                                   Text="Incoming Call"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="#30D158"
                                   MaxWidth="120"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center: Notch Spacer -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Quick Accept / Decline Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Mini Decline Button (Red) -->
                        <Border x:Name="CompactDeclineBtn"
                                Width="26" Height="26"
                                CornerRadius="13"
                                Background="#FF453A"
                                Cursor="Hand"
                                Margin="0,0,8,0"
                                MouseDown="DeclineCall_Click">
                            <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <!-- End call / Downward handset -->
                                    <Path Fill="White"
                                          Data="M 12,9 C 8.7,9 5.7,10.1 3.3,12 L 1.2,9.9 C 4.1,7.4 7.9,6 12,6 C 16.1,6 19.9,7.4 22.8,9.9 L 20.7,12 C 18.3,10.1 15.3,9 12,9 Z M 5.1,16.5 C 5.5,16.1 6,15.9 6.6,15.9 C 7.2,15.9 7.7,16.1 8.1,16.5 L 9.9,18.3 C 10.3,18.7 10.5,19.2 10.5,19.8 L 10.5,21.5 C 10.5,22.3 9.8,23 9,23 L 4.5,23 C 3.7,23 3,22.3 3,21.5 L 3,18.8 C 3,18 3.3,17.2 3.9,16.6 L 5.1,16.5 Z M 18.9,16.5 C 19.5,17.1 19.8,17.9 19.8,18.8 L 19.8,21.5 C 19.8,22.3 19.1,23 18.3,23 L 13.8,23 C 13,23 12.3,22.3 12.3,21.5 L 12.3,19.8 C 12.3,19.2 12.5,18.7 12.9,18.3 L 14.7,16.5 C 15.1,16.1 15.6,15.9 16.2,15.9 C 16.8,15.9 17.3,16.1 17.7,16.5 L 18.9,16.5 Z" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Mini Accept Button (Green) -->
                        <Border x:Name="CompactAcceptBtn"
                                Width="26" Height="26"
                                CornerRadius="13"
                                Background="#30D158"
                                Cursor="Hand"
                                MouseDown="AcceptCall_Click">
                            <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White"
                                          Data="M 6.62,10.79 C 8.06,13.62 10.38,15.94 13.21,17.38 L 15.41,15.18 C 15.69,14.9 16.08,14.82 16.43,14.93 C 17.55,15.3 18.75,15.5 20,15.5 C 20.55,15.5 21,15.95 21,16.5 L 21,20 C 21,20.55 20.55,21 20,21 C 10.61,21 3,13.39 3,4 C 3,3.45 3.45,3 4,3 L 7.5,3 C 8.05,3 8.5,3.45 8.5,4 C 8.5,5.25 8.7,6.45 9.07,7.57 C 9.18,7.92 9.1,8.31 8.82,8.59 L 6.62,10.79 Z" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 11. Screen Recording Mode: Matches media_1794687755340_89cff412.png -->
                <Grid x:Name="CompactScreenRecordingView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="0">
                    <Ellipse x:Name="ScreenRecPulseDot"
                             Width="9" Height="9"
                             Fill="#FF453A"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                    <controls:WifiNetworkGlyph x:Name="ScreenRecordingWifiStatusGlyph"
                                               Width="16" Height="16"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               Visibility="Collapsed" />
                </Grid>

                <!-- 12. Night Mode Alert Mode (Orange Crescent Moon) -->
                <Grid x:Name="CompactNightModeView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="8,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Orange Moon Capsule Badge -->
                    <Border x:Name="CompactNightModeBadge"
                            Grid.Column="0"
                            Width="54" Height="28"
                            CornerRadius="14"
                            Background="#FF9500"
                            VerticalAlignment="Center">
                        <!-- Crescent Moon Icon -->
                        <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="CompactNightModeMoonIcon"
                                  Fill="White"
                                  Data="M 12.3,10.2 C 7.5,10.2 3.6,6.3 3.6,1.5 C 3.6,1.0 3.7,0.5 3.8,0 C 1.5,1.2 0,3.6 0,6.4 C 0,10.5 3.3,13.8 7.4,13.8 C 10.2,13.8 12.6,12.3 13.8,10.0 C 13.3,10.1 12.8,10.2 12.3,10.2 Z" />
                        </Canvas>
                    </Border>

                    <!-- Center: Notch Space -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Text "Night Mode On" (in #FF9F0A) -->
                    <TextBlock x:Name="CompactNightModeText"
                               Grid.Column="2"
                               Text="Night Mode On"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#FF9F0A"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                </Grid>

                <!-- 15. Windows Power Mode Alert Mode ("Best Power Efficiency", "Balanced", "Best Performance") -->
                <Grid x:Name="CompactPowerModeView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="10,0,16,0"
                      Background="Transparent"
                      Cursor="Hand"
                      MouseDown="CompactPowerModeView_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Solid Color Oval Rectangle (Pure Green, Blue, or Red pill; leaf icon for Low Power Mode) -->
                    <Border x:Name="CompactPowerModeBadge"
                            Grid.Column="0"
                            Width="36" Height="20"
                            CornerRadius="10"
                            Background="#30D158"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect x:Name="PowerModeBadgeGlow" Color="#30D158" BlurRadius="8" ShadowDepth="0" Opacity="0.6" />
                        </Border.Effect>
                        <Image x:Name="CompactPowerModeLeafIcon"
                               Source="pack://application:,,,/Resources/lowpower_leaf.png"
                               Width="16" Height="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed" />
                    </Border>

                    <!-- Center: Notch Space -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Text Mode Name -->
                    <TextBlock x:Name="CompactPowerModeText"
                               Grid.Column="2"
                               Text="Best Power Efficiency"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="#30D158"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                </Grid>

                <!-- 13. Active Alarm Ringing Mode: Clean display ("Alarm" with Orange Alarm Clock Icon) -->
                <Grid x:Name="CompactAlarmView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="8,0,8,0"
                      Cursor="Hand"
                      MouseDown="CompactAlarmView_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Custom Vector Orange Alarm Clock with black hands -->
                        <Viewbox Width="24" Height="24" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <RotateTransform x:Name="AlarmIconRotate" Angle="0" />
                            </Viewbox.RenderTransform>
                            <Canvas Width="26" Height="26">
                                <!-- Left Bell / Ear -->
                                <Path Fill="#FFA000" Data="M 4,7.8 C 2.2,5.6 3.0,2.8 5.5,2.0 C 7.6,1.4 9.6,2.6 10.0,4.2 C 7.8,4.6 5.8,5.8 4,7.8 Z" />
                                <!-- Right Bell / Ear -->
                                <Path Fill="#FFA000" Data="M 22,7.8 C 23.8,5.6 23.0,2.8 20.5,2.0 C 18.4,1.4 16.4,2.6 16.0,4.2 C 18.2,4.6 20.2,5.8 22,7.8 Z" />
                                <!-- Left Foot -->
                                <Line X1="6.8" Y1="19.2" X2="4.0" Y2="23.2" Stroke="#FFA000" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <!-- Right Foot -->
                                <Line X1="19.2" Y1="19.2" X2="22.0" Y2="23.2" Stroke="#FFA000" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <!-- Clock Body (Orange Circle) -->
                                <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="19" Height="19" Fill="#FFA000" />
                                <!-- Black Clock Hands (Center at 13, 13; Hour hand up to 8.5, minute hand left to 8.5) -->
                                <Path Stroke="Black" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 8.5,13 H 13 V 8.2" />
                            </Canvas>
                        </Viewbox>

                        <!-- "Alarm" Title Text in Vibrant Apple Orange (#FFA000) -->
                        <TextBlock x:Name="CompactAlarmTitleText"
                                   Text="Alarm"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#FFA000"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 14. Bluetooth Device Connection Glimpse Mode (Matches media_1794688252060_17c6c32a.png) -->
                <Grid x:Name="CompactBluetoothView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="10,0,12,0"
                      Background="Transparent"
                      Cursor="Hand"
                      MouseDown="CompactBluetoothView_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Bluetooth / Mobile / Headphone Device Icon + Connected Device Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="CompactBluetoothIcon"
                               Source="pack://application:,,,/Resources/bluetooth_logo.png"
                               Width="18" Height="18"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="CompactBluetoothDeviceName"
                                   Text=""
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center Gap -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Battery Cell Indicator (Percentage + Battery Cell Icon) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
                        <TextBlock x:Name="CompactBluetoothBatteryPercentText"
                                   Text="100%"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#30D158"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0" />
                        <!-- Battery Cell Shell -->
                        <Border Width="22" Height="11.5"
                                CornerRadius="3"
                                BorderBrush="#7C7C80"
                                BorderThickness="1.2"
                                Background="Transparent"
                                VerticalAlignment="Center">
                            <Border x:Name="CompactBluetoothBatteryFill"
                                    Height="7.5"
                                    CornerRadius="1.5"
                                    Background="#30D158"
                                    HorizontalAlignment="Left"
                                    Margin="1,0,0,0"
                                    Width="18" />
                        </Border>
                        <!-- Positive Terminal Nub (+) -->
                        <Border Width="1.5" Height="4"
                                CornerRadius="0.8"
                                Background="#7C7C80"
                                VerticalAlignment="Center"
                                Margin="0.8,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 15. Wi-Fi / Mobile Hotspot activity with a gently pulsing signal glyph -->
                <Grid x:Name="CompactWifiView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Background="Transparent"
                      ToolTip="Wi-Fi connection or mobile hotspot is active">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0">
                        <Image x:Name="CompactWifiIcon"
                               Source="pack://application:,,,/Resources/wifi_icon.png"
                               Width="22" Height="19"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Image x:Name="CompactHotspotIcon"
                               Source="pack://application:,,,/Resources/hotspot_icon.png"
                               Width="22" Height="19"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="CompactWifiStatusText"
                                   Text="Wi-Fi"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   MaxWidth="190"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- EXPANDED VIEWS (Clean Single-Row Player Card)  -->
            <!-- ============================================== -->
            <Grid x:Name="ExpandedContainer"
                  Opacity="0.0"
                  Visibility="Collapsed"
                  Margin="22,10,22,10"
                  ClipToBounds="True"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Active View Container -->
                <Grid Grid.Row="0" VerticalAlignment="Center">

                    <!-- ============================================== -->
                    <!-- 1. MEDIA PLAYBACK VIEW (Matches Image 1)       -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewMediaPlayback" Visibility="Visible" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Large Rounded Artwork (Matches Image 1 lime/album square) -->
                        <Border Grid.Column="0"
                                Width="50" Height="50"
                                CornerRadius="12"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Margin="0,0,18,0"
                                VerticalAlignment="Center">
                            <Grid>
                                <Rectangle x:Name="ExpandedDefaultOrb" Fill="{DynamicResource AccentColorBrush}" />
                                <Image x:Name="ExpandedAlbumImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                <ui:SymbolIcon x:Name="ExpandedOrbSymbol" Symbol="MusicNote224" FontSize="20" Foreground="{DynamicResource PlayButtonForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Center: Clean Bold Title & Artist with generous spacious margins -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock x:Name="ExpandedTitleText"
                                       Text="rockstar"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ExpandedArtistText"
                                       Text="Post Malone"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Right: Clean Clustered Controls (Prev, Big Circular Play/Pause, Next) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Previous -->
                            <Button x:Name="PreviousButton"
                                    Style="{StaticResource WinUI3CircularSubtleButton}"
                                    Width="36" Height="36"
                                    ToolTip="Previous"
                                    Margin="0,0,10,0"
                                    Click="PreviousButton_Click">
                                <ui:SymbolIcon Symbol="Previous24" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Button>

                            <!-- Circular Play / Pause Button (Large 44x44 Solid White circle) -->
                            <Button x:Name="PlayPauseButton"
                                    Style="{StaticResource WinUI3PlayButton}"
                                    Width="44" Height="44"
                                    Margin="0,0,10,0"
                                    Click="PlayPauseButton_Click">
                                <ui:SymbolIcon x:Name="PlayPauseIcon" Symbol="Pause24" FontSize="18" Foreground="{DynamicResource PlayButtonForegroundBrush}" />
                            </Button>

                            <!-- Next -->
                            <Button x:Name="NextButton"
                                    Style="{StaticResource WinUI3CircularSubtleButton}"
                                    Width="36" Height="36"
                                    ToolTip="Next"
                                    Click="NextButton_Click">
                                <ui:SymbolIcon Symbol="Next24" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Button>

                            <!-- Lyrics Toggle Button (Double Quotes Icon) -->
                            <Button x:Name="ExpandedLyricsButton"
                                    Style="{StaticResource WinUI3CircularSubtleButton}"
                                    Width="36" Height="36"
                                    ToolTip="Live Lyrics / Captions"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed"
                                    Click="ExpandedLyricsButton_Click">
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="ExpandedLyricsIconPath" Fill="{DynamicResource TextSecondaryBrush}"
                                              Data="M 4.5,11 C 4.5,7.2 7.0,5.0 10.2,4.2 L 10.8,6.0 C 8.5,6.6 7.2,8.0 7.0,9.8 L 9.8,9.8 C 10.9,9.8 11.8,10.7 11.8,11.8 L 11.8,16.5 C 11.8,17.6 10.9,18.5 9.8,18.5 L 6.5,18.5 C 5.4,18.5 4.5,17.6 4.5,16.5 Z M 14.5,11 C 14.5,7.2 17.0,5.0 20.2,4.2 L 20.8,6.0 C 18.5,6.6 17.2,8.0 17.0,9.8 L 19.8,9.8 C 20.9,9.8 21.8,10.7 21.8,11.8 L 21.8,16.5 C 21.8,17.6 20.9,18.5 19.8,18.5 L 16.5,18.5 C 15.4,18.5 14.5,17.6 14.5,16.5 Z" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 2. CONNECTED DEVICES BATTERY (Image 2)         -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewDeviceBattery" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Glowing Green Device Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1A107C41" BorderBrush="#33107C41" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Headphones24" FontSize="20" Foreground="#107C41" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Device Name & Battery Pills -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="BatteryDeviceName" Text="AirPods Pro" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <!-- Left Earbud -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="8,2,8,2" Margin="0,0,6,0">
                                    <TextBlock Text="L  80%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <!-- Right Earbud -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="8,2,8,2" Margin="0,0,6,0">
                                    <TextBlock Text="R  78%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <!-- Case -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="8,2,8,2">
                                    <TextBlock Text="Case  100%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Green Check Badge -->
                        <Border Grid.Column="2" Width="26" Height="26" CornerRadius="13" Background="#107C41" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 3. APP NOTIFICATION CARD (Apple Dynamic Island)-->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewAppNotification" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: App Squircle Icon (42x42 with clean padding) -->
                        <controls:AppIconControl x:Name="ExpandedNotifIcon"
                                                 Grid.Column="0"
                                                 Width="42" Height="42"
                                                 CornerRadius="11"
                                                 IconPadding="7"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,14,0" />

                        <!-- Right: Two-row Layout (Row 0: App Title + "now", Row 1: Full-width Message) -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: App Name / Title on Left, "now" Timestamp on Far Right -->
                            <Grid Grid.Row="0" Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="NotificationTitleText"
                                           Grid.Column="0"
                                           Text="WhatsApp"
                                           FontSize="14.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />

                                <TextBlock x:Name="NotificationTimeText"
                                           Grid.Column="1"
                                           Text="now"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,2,0" />
                            </Grid>

                            <!-- Row 1: Notification Message (Full width across, wraps up to 2 clean lines without clipping) -->
                            <TextBlock x:Name="NotificationSubtext"
                                       Grid.Row="1"
                                       Text="New message received"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap"
                                       MaxHeight="36"
                                       LineHeight="17"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 4. FOCUS TIMER MODE (Image 4 pill)             -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewFocusTimer" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Focus Icon -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#22D97706" BorderBrush="#44D97706" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="20" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FocusTimerTitleText" Text="Timer Active" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="FocusCountdownText" Text="0:58 remaining" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FocusToggleButton" Content="Pause" Style="{StaticResource WinUI3IconButton}" Background="{DynamicResource SubtleHoverBrush}" Padding="12,5,12,5" Margin="0,0,6,0" Click="FocusToggleButton_Click" />
                            <Button x:Name="FocusCancelButton" Content="Cancel" Style="{StaticResource WinUI3IconButton}" Background="{DynamicResource SubtleHoverBrush}" Padding="12,5,12,5" Click="FocusCancelButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 5. LIVE ACTIVITIES & TASKS (Image 4 build)      -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewLiveActivities" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Build / Task Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#220078D4" BorderBrush="#440078D4" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Code24" FontSize="20" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="build — Background Task" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Compiling WindowsLive release • 68% complete" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <ProgressBar Grid.Column="2" Width="70" Height="6" Value="68" Maximum="100" Foreground="{DynamicResource AccentColorBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 6. LIVE BRIGHTNESS & AUDIO LEVELS (Image 5)    -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewHardwareLevels" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Volume Level Bar (White capsule style matching Image 5) -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Symbol="Speaker224" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <ProgressBar x:Name="HardwareVolumeBar" Grid.Column="1" Height="14" Value="72" Maximum="100" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource CardBackgroundBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HardwareVolumeText" Grid.Column="2" Text="72%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Brightness Level Bar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Symbol="BrightnessHigh24" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <Slider x:Name="HardwareBrightnessSlider" Grid.Column="1" Style="{StaticResource WinUI3Slider}" Minimum="0" Maximum="100" Value="50" ValueChanged="HardwareBrightnessSlider_ValueChanged" />
                            <TextBlock x:Name="HardwareBrightnessText" Grid.Column="2" Text="50%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 7. LIVE CLIPBOARD SHELF (Image 6)              -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewLiveClipboard" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#30D158" Data="M 9,16.17 L 4.83,12 L 3.41,13.41 L 9,19 L 21,7 L 19.59,5.59 Z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Copied" FontSize="14" FontWeight="SemiBold" Foreground="#30D158" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 8. WINDOW SNAPPING CONTROLS (Item 8)           -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewWindowSnapping" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Snap Active Window" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" HorizontalAlignment="Center" />

                        <!-- Snapping Preset Buttons -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Left Half" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapLeft_Click" />
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Right Half" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapRight_Click" />
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Top Half" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapTop_Click" />
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Maximize" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapMax_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 9. TIMER SET WINDOW (Image 7)                  -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewTimerQuickSet" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,4,8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Search / Input Pill (Matches Image 7) -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="10,6,10,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="tim" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Grid.Column="1" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{DynamicResource SubtleHoverBrush}" CornerRadius="4" Padding="4,1,4,1">
                                    <TextBlock Text="esc" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Action Item 1: Start Focus Timer -->
                        <Button Grid.Row="1" Style="{StaticResource WinUI3IconButton}" HorizontalContentAlignment="Stretch" Padding="10,6,10,6" Margin="0,0,0,4" Background="{DynamicResource SubtleHoverBrush}" Click="StartFocusTimerPreset_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start a focus timer" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="25m" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Action Item 2: Quick Stopwatch / 15m Timer -->
                        <Button Grid.Row="2" Style="{StaticResource WinUI3IconButton}" HorizontalContentAlignment="Stretch" Padding="10,6,10,6" Background="Transparent" Click="Start15MinTimer_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Short Break Timer" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="5m" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 10. VOICE RECORDING EXPANDED MODE              -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewVoiceRecording" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Recording Icon Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#22FF453A" BorderBrush="#44FF453A" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Record24" FontSize="20" Foreground="#FF453A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="RecordingAppNameText" Text="Voice Recording Active" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="RecordingDurationSubtext" Text="00:00 recorded" FontSize="12" Foreground="#FF453A" Margin="0,3,0,0" />
                        </StackPanel>

                        <Border Grid.Column="2" Background="#22FF453A" CornerRadius="12" Padding="10,4,10,4" VerticalAlignment="Center">
                            <TextBlock Text="RECORDING" FontSize="11" FontWeight="Bold" Foreground="#FF453A" />
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 10.5. INCOMING CALL EXPANDED BANNER (Apple Dynamic Island) -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewIncomingCall" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,4,2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Caller Profile Avatar or App Squircle (52x52) -->
                        <Grid Grid.Column="0" Width="52" Height="52" Margin="0,0,14,0" VerticalAlignment="Center">
                            <!-- Circular Avatar Background / Fallback -->
                            <Border x:Name="IncomingCallerAvatarBorder"
                                    Width="52" Height="52"
                                    CornerRadius="26"
                                    Background="#2C2C2E"
                                    ClipToBounds="True">
                                <Image x:Name="IncomingCallerAvatarImage"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>

                            <!-- Fallback Initials / App Icon -->
                            <controls:AppIconControl x:Name="IncomingCallAppIcon"
                                                     Width="52" Height="52"
                                                     CornerRadius="26"
                                                     IconPadding="12"
                                                     Visibility="Collapsed" />

                            <!-- Mini Phone Badge on Avatar bottom-right -->
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="#30D158"
                                    BorderBrush="#000000" BorderThickness="1.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,-2,-2">
                                <Viewbox Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White"
                                              Data="M 6.62,10.79 C 8.06,13.62 10.38,15.94 13.21,17.38 L 15.41,15.18 C 15.69,14.9 16.08,14.82 16.43,14.93 C 17.55,15.3 18.75,15.5 20,15.5 C 20.55,15.5 21,15.95 21,16.5 L 21,20 C 21,20.55 20.55,21 20,21 C 10.61,21 3,13.39 3,4 C 3,3.45 3.45,3 4,3 L 7.5,3 C 8.05,3 8.5,3.45 8.5,4 C 8.5,5.25 8.7,6.45 9.07,7.57 C 9.18,7.92 9.1,8.31 8.82,8.59 L 6.62,10.79 Z" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>

                        <!-- Caller Information (Title & App / Subtext) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="IncomingCallSubtext"
                                       Text="INCOMING CALL"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#8E8E93"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock x:Name="IncomingCallerNameText"
                                       Text="John Appleseed"
                                       FontSize="17.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Margin="0,2,0,0" />
                            <TextBlock x:Name="IncomingCallAppNameText"
                                       Text="WhatsApp Audio"
                                       FontSize="12"
                                       Foreground="#30D158"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Action Buttons: Decline (Red circular #FF453A) and Accept (Green circular #30D158) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,2,0">
                            <!-- Decline Button -->
                            <Button x:Name="ExpandedDeclineCallButton"
                                    Width="46" Height="46"
                                    Margin="0,0,12,0"
                                    Cursor="Hand"
                                    Click="DeclineCall_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder"
                                                Width="46" Height="46"
                                                CornerRadius="23"
                                                Background="#FF453A">
                                            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="White"
                                                          Data="M 12,9 C 8.7,9 5.7,10.1 3.3,12 L 1.2,9.9 C 4.1,7.4 7.9,6 12,6 C 16.1,6 19.9,7.4 22.8,9.9 L 20.7,12 C 18.3,10.1 15.3,9 12,9 Z M 5.1,16.5 C 5.5,16.1 6,15.9 6.6,15.9 C 7.2,15.9 7.7,16.1 8.1,16.5 L 9.9,18.3 C 10.3,18.7 10.5,19.2 10.5,19.8 L 10.5,21.5 C 10.5,22.3 9.8,23 9,23 L 4.5,23 C 3.7,23 3,22.3 3,21.5 L 3,18.8 C 3,18 3.3,17.2 3.9,16.6 L 5.1,16.5 Z M 18.9,16.5 C 19.5,17.1 19.8,17.9 19.8,18.8 L 19.8,21.5 C 19.8,22.3 19.1,23 18.3,23 L 13.8,23 C 13,23 12.3,22.3 12.3,21.5 L 12.3,19.8 C 12.3,19.2 12.5,18.7 12.9,18.3 L 14.7,16.5 C 15.1,16.1 15.6,15.9 16.2,15.9 C 16.8,15.9 17.3,16.1 17.7,16.5 L 18.9,16.5 Z" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#D9362C" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Accept Button -->
                            <Button x:Name="ExpandedAcceptCallButton"
                                    Width="46" Height="46"
                                    Cursor="Hand"
                                    Click="AcceptCall_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder"
                                                Width="46" Height="46"
                                                CornerRadius="23"
                                                Background="#30D158">
                                            <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="White"
                                                          Data="M 6.62,10.79 C 8.06,13.62 10.38,15.94 13.21,17.38 L 15.41,15.18 C 15.69,14.9 16.08,14.82 16.43,14.93 C 17.55,15.3 18.75,15.5 20,15.5 C 20.55,15.5 21,15.95 21,16.5 L 21,20 C 21,20.55 20.55,21 20,21 C 10.61,21 3,13.39 3,4 C 3,3.45 3.45,3 4,3 L 7.5,3 C 8.05,3 8.5,3.45 8.5,4 C 8.5,5.25 8.7,6.45 9.07,7.57 C 9.18,7.92 9.1,8.31 8.82,8.59 L 6.62,10.79 Z" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#28B84B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 12. BLUETOOTH DEVICE ENLARGED (Matches Photo 2) -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewBluetoothDevice" Visibility="Collapsed" VerticalAlignment="Center" Margin="6,2,6,2"
                          Background="Transparent" Cursor="Hand" MouseDown="ViewBluetoothDevice_MouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Device Icon (Bluetooth badge, Headphones, or Mobile) -->
                        <Image x:Name="ExpandedBluetoothIcon"
                               Source="pack://application:,,,/Resources/bluetooth_logo.png"
                               Width="28" Height="28"
                               VerticalAlignment="Center"
                               Margin="4,0,16,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- Middle: "Connected" + "[DeviceName] ready to use" -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Connected"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       Foreground="#98989D"
                                       Margin="0,0,0,2" />
                            <TextBlock x:Name="ExpandedBluetoothTitleText"
                                       Text="Audio device ready to use"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF" />
                        </StackPanel>

                        <!-- Right: Battery Cell Indicator (Percentage + Battery Cell Icon) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,4,0">
                            <TextBlock x:Name="ExpandedBluetoothBatteryPercentText"
                                       Text="100%"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#30D158"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <!-- Battery Cell Shell -->
                            <Border Width="28" Height="14"
                                    CornerRadius="3.5"
                                    BorderBrush="#8E8E93"
                                    BorderThickness="1.5"
                                    Background="Transparent"
                                    VerticalAlignment="Center">
                                <Border x:Name="ExpandedBluetoothBatteryFill"
                                        Height="9"
                                        CornerRadius="1.8"
                                        Background="#30D158"
                                        HorizontalAlignment="Left"
                                        Margin="1.5,0,0,0"
                                        Width="22" />
                            </Border>
                            <!-- Positive Terminal Nub (+) -->
                            <Border Width="2" Height="5.5"
                                    CornerRadius="1"
                                    Background="#8E8E93"
                                    VerticalAlignment="Center"
                                    Margin="1,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 13. LIVE LYRICS / CAPTIONS (Kinetic Fluid Dual-Layer) -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewLiveLyrics"
                          Visibility="Collapsed"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Stretch"
                          ClipToBounds="True"
                          Cursor="Hand"
                          Background="Transparent"
                          MouseDown="ViewLiveLyrics_MouseDown"
                          ToolTip="Click to toggle lyrics / media player">
                        
                        <!-- Layer A -->
                        <Grid x:Name="LyricsLayerA"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="LyricsTransA" Y="0" />
                            </Grid.RenderTransform>
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="16,2,16,2">
                                <TextBlock x:Name="LyricsA_Prev"
                                           Text=""
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#8D8D8D"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           HorizontalAlignment="Center"
                                           Opacity="0.65"
                                           Margin="0,0,0,3" />
                                <TextBlock x:Name="LyricsA_Curr"
                                           Text="♪ Loading Lyrics... ♪"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentColorBrush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="LyricsA_Scale" ScaleX="1.0" ScaleY="1.0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="LyricsA_Next"
                                           Text=""
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#8D8D8D"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           HorizontalAlignment="Center"
                                           Opacity="0.65" />
                            </StackPanel>
                        </Grid>

                        <!-- Layer B -->
                        <Grid x:Name="LyricsLayerB"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              Opacity="0.0"
                              Visibility="Collapsed"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="LyricsTransB" Y="0" />
                            </Grid.RenderTransform>
                            <StackPanel Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="16,2,16,2">
                                <TextBlock x:Name="LyricsB_Prev"
                                           Text=""
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#8D8D8D"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           HorizontalAlignment="Center"
                                           Opacity="0.65"
                                           Margin="0,0,0,3" />
                                <TextBlock x:Name="LyricsB_Curr"
                                           Text=""
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentColorBrush}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="LyricsB_Scale" ScaleX="1.0" ScaleY="1.0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="LyricsB_Next"
                                           Text=""
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#8D8D8D"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           HorizontalAlignment="Center"
                                           Opacity="0.65" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>

            <!-- Privacy Indicator Lights (Camera = Green, Microphone = Orange) in the Notch -->
            <StackPanel x:Name="PrivacyIndicatorPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0.0">
                <!-- Camera Green Dot -->
                <Ellipse x:Name="CameraPrivacyDot"
                         Width="7.5" Height="7.5"
                         Fill="#30D158"
                         Margin="3,0,3,0"
                         Visibility="Collapsed">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#30D158" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Microphone Orange Dot -->
                <Ellipse x:Name="MicPrivacyDot"
                         Width="7.5" Height="7.5"
                         Fill="#FF9F0A"
                         Margin="3,0,3,0"
                         Visibility="Collapsed">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FF9F0A" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                    </Ellipse.Effect>
                </Ellipse>
            </StackPanel>

            <!-- ========================================================================================= -->
            <!-- DRAG & DROP OPEN CLIPBOARD OVERLAY                                                        -->
            <!-- Blank enlarged dock during drag; Left edge = Copied (green tick), Right edge = Share UI   -->
            <!-- ========================================================================================= -->
            <Grid x:Name="DragDropFeedbackOverlay"
                  Visibility="Collapsed"
                  Opacity="0.0"
                  IsHitTestVisible="False"
                  Panel.ZIndex="1000"
                  ClipToBounds="True"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch">

                <!-- Feedback uses the same attached-notch shape as the dock so it cannot
                     turn into a rectangular panel while obscuring other content. -->
                <controls:DynamicIslandNotch IsNotchMode="True"
                                             EarFillet="12"
                                             CornerRadius="16"
                                             Fill="{DynamicResource SurfaceDarkBrush}"
                                             Stroke="{DynamicResource SurfaceBorderBrush}"
                                             StrokeThickness="1" />

                <!-- Left Zone Preview: Clean Green Tick + "Copy" text -->
                <StackPanel x:Name="DragCopyIndicator"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Visibility="Collapsed">
                    <Viewbox Width="17" Height="17" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#30D158"
                                  Data="M 9,16.17 L 4.83,12 L 3.41,13.41 L 9,19 L 21,7 L 19.59,5.59 Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Copy"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#30D158"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right Zone Preview: Share Icon + "Share" text -->
                <StackPanel x:Name="DragShareIndicator"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0"
                            Visibility="Collapsed">
                    <TextBlock Text="Share"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="#0A84FF"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <!-- Windows / Apple Share Tray Vector Icon -->
                            <Path Fill="#0A84FF"
                                  Data="M 12,2 L 7,7 L 8.41,8.41 L 11,5.83 L 11,15 L 13,15 L 13,5.83 L 15.59,8.41 L 17,7 L 12,2 Z M 5,10 C 3.9,10 3,10.9 3,12 L 3,19 C 3,20.1 3.9,21 5,21 L 19,21 C 20.1,21 21,20.1 21,19 L 21,12 C 21,10.9 20.1,10 19,10 L 15,10 L 15,12 L 19,12 L 19,19 L 5,19 L 5,12 L 9,12 L 9,10 L 5,10 Z" />
                        </Canvas>
                    </Viewbox>
                </StackPanel>

                <!-- Dropped Success Popout Feedback: Clean Green Tick + "Copied" -->
                <StackPanel x:Name="DragCopiedSuccessIndicator"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#30D158"
                                  Data="M 9,16.17 L 4.83,12 L 3.41,13.41 L 9,19 L 21,7 L 19.59,5.59 Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Copied"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#30D158"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Dropped Share Success Popout Feedback: Share Icon + "Sharing" -->
                <StackPanel x:Name="DragShareSuccessIndicator"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Viewbox Width="17" Height="17" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#0A84FF"
                                  Data="M 12,2 L 7,7 L 8.41,8.41 L 11,5.83 L 11,15 L 13,15 L 13,5.83 L 15.59,8.41 L 17,7 L 12,2 Z M 5,10 C 3.9,10 3,10.9 3,12 L 3,19 C 3,20.1 3.9,21 5,21 L 19,21 C 20.1,21 21,20.1 21,19 L 21,12 C 21,10.9 20.1,10 19,10 L 15,10 L 15,12 L 19,12 L 19,19 L 5,19 L 5,12 L 9,12 L 9,10 L 5,10 Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Sharing..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0A84FF"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ========================================================================================= -->
        <!-- DETACHED SATELLITE CAPSULES (Multi-Activity: Up to 2 pills, placed on either side of notch) -->
        <!-- Satellite Left: Detached Left Capsule (e.g. Timer or secondary activity)                    -->
        <!-- Satellite Right: Detached Right Capsule (e.g. Timer, call, or task status)                 -->
        <!-- ========================================================================================= -->
        <!-- Left Satellite Pill (position translated left of notch center) -->
        <Grid x:Name="DetachedLeftContainer"
              Height="36"
              MinWidth="76"
              VerticalAlignment="Top"
              HorizontalAlignment="Center"
              Cursor="Hand"
              Visibility="Collapsed"
              Opacity="0.0"
              MouseEnter="DetachedLeftContainer_MouseEnter"
              MouseLeave="DetachedLeftContainer_MouseLeave"
              MouseDown="DetachedLeftContainer_MouseDown">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DetachedLeftTranslate" X="0" Y="0" />
            </Grid.RenderTransform>
            <!-- Shadow -->
            <controls:DynamicIslandNotch IsNotchMode="False"
                                         CornerRadius="18"
                                         Fill="#000000"
                                         StrokeThickness="0">
                <controls:DynamicIslandNotch.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" Opacity="0.45" ShadowDepth="3" Direction="270" />
                </controls:DynamicIslandNotch.Effect>
            </controls:DynamicIslandNotch>
            <!-- Surface Base Pill -->
            <controls:DynamicIslandNotch IsNotchMode="False"
                                         CornerRadius="18"
                                         Fill="{DynamicResource SurfaceDarkBrush}"
                                         Stroke="{DynamicResource SurfaceBorderBrush}"
                                         StrokeThickness="1" />
            <!-- Content: Adaptive multi-task icon (mic, call, screen rec, timer) + text -->
            <StackPanel x:Name="DetachedLeftContent" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,12,0">
                <!-- Red Voice Recording Mic Icon -->
                <Viewbox x:Name="DetachedLeftMicIcon" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Visible">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#FF453A"
                              Data="M 12,14 C 13.66,14 15,12.66 15,11 L 15,5 C 15,3.34 13.66,2 12,2 C 10.34,2 9,3.34 9,5 L 9,11 C 9,12.66 10.34,14 12,14 Z M 19,10 C 19,13.53 16.39,16.44 13,16.93 L 13,20 L 16,20 C 16.55,20 17,20.45 17,21 C 17,21.55 16.55,22 16,22 L 8,22 C 7.45,22 7,21.55 7,21 C 7,20.45 7.45,20 8,20 L 11,20 L 11,16.93 C 7.61,16.44 5,13.53 5,10 C 5,9.45 5.45,9 6,9 C 6.55,9 7,9.45 7,10 C 7,12.76 9.24,15 12,15 C 14.76,15 17,12.76 17,10 C 17,9.45 17.45,9 18,9 C 18.55,9 19,9.45 19,10 Z" />
                    </Canvas>
                </Viewbox>

                <!-- Green Call Telephone Handset Icon -->
                <Viewbox x:Name="DetachedLeftCallIcon" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#30D158"
                              Data="M 6.62,10.79 C 8.06,13.62 10.38,15.94 13.21,17.38 L 15.41,15.18 C 15.69,14.9 16.08,14.82 16.43,14.93 C 17.55,15.3 18.75,15.5 20,15.5 C 20.55,15.5 21,15.95 21,16.5 L 21,20 C 21,20.55 20.55,21 20,21 C 10.61,21 3,13.39 3,4 C 3,3.45 3.45,3 4,3 L 7.5,3 C 8.05,3 8.5,3.45 8.5,4 C 8.5,5.25 8.7,6.45 9.07,7.57 C 9.18,7.92 9.1,8.31 8.82,8.59 L 6.62,10.79 Z" />
                    </Canvas>
                </Viewbox>

                <!-- Amber Timer Icon -->
                <Viewbox x:Name="DetachedLeftTimerIcon" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed">
                    <Canvas Width="20" Height="20">
                        <Ellipse Width="18" Height="18" Canvas.Left="1" Canvas.Top="1"
                                 Stroke="#FF9F0A" StrokeThickness="2.0" Fill="Transparent" />
                        <Path Stroke="#FF9F0A" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 10,10 L 10,5 M 10,10 L 13.5,10" />
                    </Canvas>
                </Viewbox>

                <TextBlock x:Name="DetachedLeftTimerText"
                           Text="0:00"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Right Satellite Pill (position translated right of notch center) -->
        <Grid x:Name="DetachedBubbleContainer"
              Height="36"
              MinWidth="76"
              VerticalAlignment="Top"
              HorizontalAlignment="Center"
              Cursor="Hand"
              Visibility="Collapsed"
              Opacity="0.0"
              MouseEnter="DetachedBubbleContainer_MouseEnter"
              MouseLeave="DetachedBubbleContainer_MouseLeave"
              MouseDown="DetachedBubbleContainer_MouseDown">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DetachedRightTranslate" X="0" Y="0" />
            </Grid.RenderTransform>
            <!-- Shadow -->
            <controls:DynamicIslandNotch x:Name="DetachedBubbleShadow"
                                         IsNotchMode="False"
                                         CornerRadius="18"
                                         Fill="#000000"
                                         StrokeThickness="0">
                <controls:DynamicIslandNotch.Effect>
                    <DropShadowEffect x:Name="DetachedShadowEffect" Color="#000000" BlurRadius="18" Opacity="0.45" ShadowDepth="3" Direction="270" />
                </controls:DynamicIslandNotch.Effect>
            </controls:DynamicIslandNotch>

            <!-- Surface Base Pill -->
            <controls:DynamicIslandNotch x:Name="DetachedBubbleNotch"
                                         IsNotchMode="False"
                                         CornerRadius="18"
                                         Fill="{DynamicResource SurfaceDarkBrush}"
                                         Stroke="{DynamicResource SurfaceBorderBrush}"
                                         StrokeThickness="1" />

            <!-- Content: Amber Clock / Timer Icon + Bold White Time Digits (e.g., 14:52) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,12,0">
                <!-- Amber Timer Icon matching reference -->
                <Viewbox Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0">
                    <Canvas Width="20" Height="20">
                        <Ellipse Width="18" Height="18" Canvas.Left="1" Canvas.Top="1"
                                 Stroke="#FF9F0A" StrokeThickness="2.0" Fill="Transparent" />
                        <Path Stroke="#FF9F0A" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 10,10 L 10,5 M 10,10 L 13.5,10" />
                    </Canvas>
                </Viewbox>

                <!-- Timer Countdown Digits (e.g., 14:52) -->
                <TextBlock x:Name="DetachedTimerCountdownText"
                           Text="14:52"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
