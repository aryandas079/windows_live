<Window x:Class="WindowsLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:WindowsLive.Controls"
        mc:Ignorable="d"
        Title=""
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="700" Height="260"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <Grid x:Name="RootGrid" Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Center">
        <!-- Top Edge Hover Zone for Maximized Apps -->
        <Border x:Name="TopEdgeHotspot"
                Height="5"
                Width="380"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Background="#01000000"
                MouseEnter="TopEdgeHotspot_MouseEnter" />

        <!-- Island Container -->
        <Grid x:Name="IslandContainer"
              Width="160" Height="36"
              VerticalAlignment="Top"
              HorizontalAlignment="Center"
              Cursor="Arrow">

            <!-- Ambient Glow / Drop Shadow Layer -->
            <controls:DynamicIslandNotch x:Name="IslandShadow"
                                         IsNotchMode="True"
                                         EarFillet="12"
                                         CornerRadius="16"
                                         Fill="#000000"
                                         StrokeThickness="0">
                <controls:DynamicIslandNotch.Effect>
                    <DropShadowEffect x:Name="IslandShadowEffect" Color="#000000" BlurRadius="18" Opacity="0.45" ShadowDepth="3" Direction="270" />
                </controls:DynamicIslandNotch.Effect>
            </controls:DynamicIslandNotch>

            <!-- Base Dock Surface (Follows System Light/Dark Theme & Solid Opaque) -->
            <controls:DynamicIslandNotch x:Name="IslandNotch"
                                         IsNotchMode="True"
                                         EarFillet="12"
                                         CornerRadius="16"
                                         Fill="{DynamicResource SurfaceDarkBrush}"
                                         Stroke="{DynamicResource SurfaceBorderBrush}"
                                         StrokeThickness="1" />

            <!-- ============================================== -->
            <!-- COMPACT VIEW (Idle / Collapsed State)          -->
            <!-- ============================================== -->
            <Grid x:Name="CompactView"
                  Height="36"
                  VerticalAlignment="Top"
                  Margin="12,0,12,0"
                  Opacity="1.0">

                <!-- 1. Default Mode: Clock & Date (Hidden by default for empty blank notch) -->
                <Grid x:Name="CompactClockView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CompactTimeText"
                               Grid.Column="0"
                               Text="2:15 PM"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <Ellipse Grid.Column="1"
                             Width="3" Height="3"
                             Fill="{DynamicResource TextSecondaryBrush}"
                             Opacity="0.6"
                             Margin="7,0,7,0"
                             VerticalAlignment="Center" />

                    <TextBlock x:Name="CompactDateText"
                               Grid.Column="2"
                               Text="Sat, Nov 14"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />

                    <!-- Green Charging Pill next to clock when plugged in -->
                    <Border x:Name="CompactChargingPill"
                            Grid.Column="3"
                            Visibility="Collapsed"
                            Background="#1A30D158"
                            BorderBrush="#4030D158"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="5,1.5,5,1.5"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseDown="CompactChargingPill_MouseDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="10" Foreground="#30D158" Margin="0,0,2.5,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompactBatteryPercentText" Text="85%" FontSize="11" FontWeight="SemiBold" Foreground="#30D158" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Media Mode: Matches Image 3 (disc icon left, animated equalizer right) -->
                <Grid x:Name="CompactMediaView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Circular Media Disc / Thumbnail -->
                    <Border Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="13"
                            ClipToBounds="True"
                            VerticalAlignment="Center"
                            Margin="2,0,0,0">
                        <Grid>
                            <Ellipse x:Name="CompactDefaultOrb" Fill="{DynamicResource AccentColorBrush}" />
                            <Image x:Name="CompactAlbumImage" Stretch="UniformToFill" Visibility="Collapsed" />
                            <ui:SymbolIcon x:Name="CompactOrbSymbol" Symbol="MusicNote224" FontSize="11" Foreground="{DynamicResource PlayButtonForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Center: Spacious Island Gap -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Animated Accent Equalizer -->
                    <controls:EqualizerControl x:Name="CompactEqualizer"
                                               Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0"
                                               AccentBrush="{DynamicResource AccentColorBrush}"
                                               IsPlaying="True" />
                </Grid>

                <!-- 3. Charging Mode: Matches Image ("Charging" on left, "84% [battery]" on right) -->
                <Grid x:Name="CompactChargingView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: "Charging" in clean white font -->
                    <TextBlock Grid.Column="0"
                               Text="Charging"
                               FontSize="15"
                               FontWeight="Normal"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />

                    <!-- Center: Spacious gap -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Percentage & Apple-Style Clean Battery Capsule -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                        <TextBlock x:Name="CompactChargingText"
                                   Text="84%"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#30D158"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />

                        <!-- Apple Battery Icon matching Image -->
                        <Grid VerticalAlignment="Center">
                            <!-- Unfilled / Background Capsule (Deep Emerald Background) -->
                            <Border Width="33" Height="16"
                                    CornerRadius="4.5"
                                    Background="#163519"
                                    BorderBrush="#245028"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <!-- Filled Level (Vibrant Apple Green #30D158) -->
                                <Border x:Name="CompactChargingBatteryFill"
                                        Width="26" Height="14"
                                        CornerRadius="3.5"
                                        Background="#30D158"
                                        HorizontalAlignment="Left" />
                            </Border>
                            <!-- Battery Terminal Cap / Nub -->
                            <Border Width="2.5" Height="6"
                                    CornerRadius="0,1.5,1.5,0"
                                    Background="#245028"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,-3,0"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 4. Notification Mode: Matches Image (App icon on left, "1" on right) -->
                <Grid x:Name="CompactNotificationView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      Cursor="Hand"
                      MouseDown="CompactNotificationView_MouseDown"
                      Margin="8,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: App Icon / Badge -->
                    <controls:AppIconControl x:Name="CompactNotifIcon"
                                             Grid.Column="0"
                                             Width="26" Height="26"
                                             CornerRadius="7"
                                             IconPadding="4"
                                             VerticalAlignment="Center"
                                             Margin="4,0,0,0" />

                    <!-- Center: black notch surface -->
                    <Grid Grid.Column="1" />

                    <!-- Right: Number "1" (Clean white font) -->
                    <TextBlock x:Name="CompactNotifCountText"
                               Grid.Column="2"
                               Text="1"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                </Grid>

                <!-- 5. Device Unlock Mode: Matches Image (Animated Opening Padlock on Left) -->
                <Grid x:Name="CompactUnlockView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Slick Animated Padlock (Matches User Uploaded Reference) -->
                    <Viewbox Grid.Column="0" Width="18" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Canvas Width="22" Height="24">
                            <!-- Shackle (Arch): Left leg goes deep to Y=12.5 so it stays rooted in the body when lifted,
                                 Right leg goes to Y=9.5 so when lifted by 3.5px it opens cleanly above the body top (Y=9.0) -->
                            <Canvas x:Name="LockShackleContainer" Width="16" Height="14" Canvas.Left="3" Canvas.Top="1">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="LockShackleTranslate" X="0" Y="0" />
                                        <ScaleTransform x:Name="LockShackleScale" ScaleX="1.0" ScaleY="1.0" CenterX="2.5" CenterY="10" />
                                        <RotateTransform x:Name="LockShackleRotate" Angle="0" CenterX="2.5" CenterY="10" />
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Path Stroke="White"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 2.5,12.5 V 5.2 C 2.5,2.6 4.7,1.2 7.5,1.2 C 10.3,1.2 12.5,2.6 12.5,5.2 V 9.5" />
                            </Canvas>

                            <!-- Padlock Body -->
                            <Rectangle Canvas.Left="3" Canvas.Top="9.0"
                                       Width="14" Height="11.5"
                                       RadiusX="3.2" RadiusY="3.2"
                                       Fill="White" />
                        </Canvas>
                    </Viewbox>

                    <!-- Center: Spacious black pill surface -->
                    <Grid Grid.Column="1" />
                </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- EXPANDED VIEWS (Clean Single-Row Player Card)  -->
            <!-- ============================================== -->
            <Grid x:Name="ExpandedContainer"
                  Opacity="0.0"
                  Visibility="Collapsed"
                  Margin="22,12,22,14"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Active View Container -->
                <Grid Grid.Row="0" VerticalAlignment="Center">

                    <!-- ============================================== -->
                    <!-- 1. MEDIA PLAYBACK VIEW (Matches Image 1)       -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewMediaPlayback" Visibility="Visible" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Large Rounded Artwork (Matches Image 1 lime/album square) -->
                        <Border Grid.Column="0"
                                Width="50" Height="50"
                                CornerRadius="12"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Margin="0,0,18,0"
                                VerticalAlignment="Center">
                            <Grid>
                                <Rectangle x:Name="ExpandedDefaultOrb" Fill="{DynamicResource AccentColorBrush}" />
                                <Image x:Name="ExpandedAlbumImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                <ui:SymbolIcon x:Name="ExpandedOrbSymbol" Symbol="MusicNote224" FontSize="20" Foreground="{DynamicResource PlayButtonForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Center: Clean Bold Title & Artist with generous spacious margins -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock x:Name="ExpandedTitleText"
                                       Text="rockstar"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ExpandedArtistText"
                                       Text="Post Malone"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Right: Clean Clustered Controls (Prev, Big Circular Play/Pause, Next) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Previous -->
                            <Button x:Name="PreviousButton"
                                    Style="{StaticResource WinUI3CircularSubtleButton}"
                                    Width="36" Height="36"
                                    ToolTip="Previous"
                                    Margin="0,0,10,0"
                                    Click="PreviousButton_Click">
                                <ui:SymbolIcon Symbol="Previous24" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Button>

                            <!-- Circular Play / Pause Button (Large 44x44 Solid White circle) -->
                            <Button x:Name="PlayPauseButton"
                                    Style="{StaticResource WinUI3PlayButton}"
                                    Width="44" Height="44"
                                    Margin="0,0,10,0"
                                    Click="PlayPauseButton_Click">
                                <ui:SymbolIcon x:Name="PlayPauseIcon" Symbol="Pause24" FontSize="18" Foreground="{DynamicResource PlayButtonForegroundBrush}" />
                            </Button>

                            <!-- Next -->
                            <Button x:Name="NextButton"
                                    Style="{StaticResource WinUI3CircularSubtleButton}"
                                    Width="36" Height="36"
                                    ToolTip="Next"
                                    Click="NextButton_Click">
                                <ui:SymbolIcon Symbol="Next24" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 2. CONNECTED DEVICES BATTERY (Image 2)         -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewDeviceBattery" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Glowing Green Device Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1A107C41" BorderBrush="#33107C41" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Headphones24" FontSize="20" Foreground="#107C41" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Device Name & Battery Pills -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="BatteryDeviceName" Text="AirPods Pro" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <!-- Left Earbud -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="8,2,8,2" Margin="0,0,6,0">
                                    <TextBlock Text="L  80%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <!-- Right Earbud -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="8,2,8,2" Margin="0,0,6,0">
                                    <TextBlock Text="R  78%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <!-- Case -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="8,2,8,2">
                                    <TextBlock Text="Case  100%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Green Check Badge -->
                        <Border Grid.Column="2" Width="26" Height="26" CornerRadius="13" Background="#107C41" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 3. APP NOTIFICATION CARD (Spacious & Modern)   -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewAppNotification" Visibility="Collapsed" VerticalAlignment="Center" Margin="2,2,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: App Header (Icon, Title, Message, "now") -->
                        <Grid Grid.Row="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- App Icon (46x46) -->
                            <controls:AppIconControl x:Name="ExpandedNotifIcon"
                                                     Grid.Column="0"
                                                     Width="46" Height="46"
                                                     CornerRadius="12"
                                                     IconPadding="9"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,16,0" />

                            <!-- Notification Content (Title & Message) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="NotificationTitleText"
                                           Text="WhatsApp"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                                <TextBlock x:Name="NotificationSubtext"
                                           Text="New message received"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Right: "now" timestamp matching reference screenshots -->
                            <TextBlock x:Name="NotificationTimeText"
                                       Grid.Column="2"
                                       Text="now"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,4,0" />
                        </Grid>

                        <!-- Row 1: Quick Reply Box with Send Arrow (WhatsApp, Telegram, Messaging Apps) -->
                        <Grid x:Name="NotificationReplyRow"
                              Grid.Row="1"
                              Visibility="Collapsed"
                              Margin="0,10,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Modern Capsule Reply Input Box -->
                            <Border Grid.Column="0"
                                    Height="34"
                                    CornerRadius="17"
                                    Background="#1AFFFFFF"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    Padding="14,0,10,0">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock x:Name="NotificationReplyPlaceholder"
                                               Text="Reply..."
                                               FontSize="13"
                                               Foreground="#70FFFFFF"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <TextBox x:Name="NotificationReplyInput"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="White"
                                             CaretBrush="White"
                                             FontSize="13"
                                             VerticalAlignment="Center"
                                             Padding="0"
                                             KeyDown="NotificationReplyInput_KeyDown"
                                             TextChanged="NotificationReplyInput_TextChanged"
                                             GotFocus="NotificationReplyInput_GotFocus"
                                             LostFocus="NotificationReplyInput_LostFocus" />
                                </Grid>
                            </Border>

                            <!-- Send Arrow Button (Circular 34x34) -->
                            <Button x:Name="NotificationSendButton"
                                    Grid.Column="1"
                                    Width="34" Height="34"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Background="#25D366"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="NotificationSendButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="17" />
                                    </Style>
                                </Button.Resources>
                                <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <!-- Crisp Send Arrow -->
                                        <Path Fill="White"
                                              Data="M 2.01,21 L 23,12 L 2.01,3 L 2,10 L 17,12 L 2,14 Z" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 4. FOCUS TIMER MODE (Image 4 pill)             -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewFocusTimer" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Focus Icon -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#22D97706" BorderBrush="#44D97706" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="20" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Focus Session Active" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="FocusCountdownText" Text="24:50 remaining" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <Button x:Name="FocusToggleButton" Grid.Column="2" Content="Pause" Style="{StaticResource WinUI3IconButton}" Background="{DynamicResource SubtleHoverBrush}" Padding="12,5,12,5" Click="FocusToggleButton_Click" />
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 5. LIVE ACTIVITIES & TASKS (Image 4 build)      -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewLiveActivities" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Build / Task Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#220078D4" BorderBrush="#440078D4" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Code24" FontSize="20" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="build — Background Task" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Compiling WindowsLive release • 68% complete" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <ProgressBar Grid.Column="2" Width="70" Height="6" Value="68" Maximum="100" Foreground="{DynamicResource AccentColorBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 6. LIVE BRIGHTNESS & AUDIO LEVELS (Image 5)    -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewHardwareLevels" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Volume Level Bar (White capsule style matching Image 5) -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Symbol="Speaker224" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <ProgressBar x:Name="HardwareVolumeBar" Grid.Column="1" Height="14" Value="72" Maximum="100" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource CardBackgroundBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HardwareVolumeText" Grid.Column="2" Text="72%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Brightness Level Bar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Symbol="BrightnessHigh24" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <Slider x:Name="HardwareBrightnessSlider" Grid.Column="1" Style="{StaticResource WinUI3Slider}" Minimum="0" Maximum="100" Value="50" ValueChanged="HardwareBrightnessSlider_ValueChanged" />
                            <TextBlock x:Name="HardwareBrightnessText" Grid.Column="2" Text="50%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 7. LIVE CLIPBOARD SHELF (Image 6)              -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewLiveClipboard" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Purple Clipboard Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#228764B8" BorderBrush="#448764B8" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="20" Foreground="#8764B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Copied to the shelf" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="ClipboardPreviewText" Text="https://notchy.dev — 3 items today" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 8. WINDOW SNAPPING CONTROLS (Item 8)           -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewWindowSnapping" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Snap Active Window" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" HorizontalAlignment="Center" />

                        <!-- Snapping Preset Buttons -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Left Half" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapLeft_Click" />
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Right Half" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapRight_Click" />
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Top Half" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapTop_Click" />
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Maximize" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapMax_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 9. TIMER SET WINDOW (Image 7)                  -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewTimerQuickSet" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,4,8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Search / Input Pill (Matches Image 7) -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="10,6,10,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="tim" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Grid.Column="1" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{DynamicResource SubtleHoverBrush}" CornerRadius="4" Padding="4,1,4,1">
                                    <TextBlock Text="esc" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Action Item 1: Start Focus Timer -->
                        <Button Grid.Row="1" Style="{StaticResource WinUI3IconButton}" HorizontalContentAlignment="Stretch" Padding="10,6,10,6" Margin="0,0,0,4" Background="{DynamicResource SubtleHoverBrush}" Click="StartFocusTimerPreset_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start a focus timer" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="25m" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Action Item 2: Quick Stopwatch / 15m Timer -->
                        <Button Grid.Row="2" Style="{StaticResource WinUI3IconButton}" HorizontalContentAlignment="Stretch" Padding="10,6,10,6" Background="Transparent" Click="Start15MinTimer_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Short Break Timer" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="5m" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
