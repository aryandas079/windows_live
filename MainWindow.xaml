<Window x:Class="WindowsLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:WindowsLive.Controls"
        mc:Ignorable="d"
        Title="Windows Live Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="640" Height="250"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial">

    <Grid x:Name="RootGrid" Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Center">
        <!-- Top Edge Hover Zone for Maximized Apps -->
        <Border x:Name="TopEdgeHotspot"
                Height="5"
                Width="380"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Background="#01000000"
                MouseEnter="TopEdgeHotspot_MouseEnter" />

        <!-- Island Container -->
        <Grid x:Name="IslandContainer"
              Width="220" Height="36"
              VerticalAlignment="Top"
              HorizontalAlignment="Center"
              Cursor="Hand">

            <!-- Ambient Glow / Drop Shadow Layer -->
            <controls:DynamicIslandNotch x:Name="IslandShadow"
                                         IsNotchMode="True"
                                         EarFillet="12"
                                         CornerRadius="16"
                                         Fill="#000000"
                                         StrokeThickness="0">
                <controls:DynamicIslandNotch.Effect>
                    <DropShadowEffect x:Name="IslandShadowEffect" Color="#000000" BlurRadius="18" Opacity="0.45" ShadowDepth="3" Direction="270" />
                </controls:DynamicIslandNotch.Effect>
            </controls:DynamicIslandNotch>

            <!-- Base Dock Surface (Follows System Light/Dark Theme & 50% Transparency) -->
            <controls:DynamicIslandNotch x:Name="IslandNotch"
                                         IsNotchMode="True"
                                         EarFillet="12"
                                         CornerRadius="16"
                                         Fill="{DynamicResource SurfaceDarkBrush}"
                                         Stroke="{DynamicResource SurfaceBorderBrush}"
                                         StrokeThickness="1" />

            <!-- ============================================== -->
            <!-- COMPACT VIEW (Idle / Collapsed State)          -->
            <!-- ============================================== -->
            <Grid x:Name="CompactView"
                  Height="34"
                  VerticalAlignment="Top"
                  Margin="14,0,14,0"
                  Opacity="1.0">

                <!-- 1. Default Mode: Clock & Date (When no media is playing) -->
                <Grid x:Name="CompactClockView"
                      Visibility="Visible"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CompactTimeText"
                               Grid.Column="0"
                               Text="2:15 PM"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <Ellipse Grid.Column="1"
                             Width="3.5" Height="3.5"
                             Fill="{DynamicResource TextSecondaryBrush}"
                             Opacity="0.6"
                             Margin="9,0,9,0"
                             VerticalAlignment="Center" />

                    <TextBlock x:Name="CompactDateText"
                               Grid.Column="2"
                               Text="Sat, Nov 14"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 2. Media Mode: Music Player Pill (When media is active) -->
                <Grid x:Name="CompactMediaView"
                      Visibility="Collapsed"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:CircularProgressArt x:Name="CompactProgressArt"
                                                  Grid.Column="0"
                                                  Width="26" Height="26"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"
                                                  AccentBrush="{DynamicResource AccentColorBrush}" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="2,0,8,0">
                        <TextBlock x:Name="CompactTitleText"
                                   Text="Now Playing"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactArtistText"
                                   Text="Artist Name"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <controls:EqualizerControl x:Name="CompactEqualizer"
                                               Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Margin="4,0,2,0"
                                               AccentBrush="{DynamicResource AccentColorBrush}"
                                               IsPlaying="True" />
                </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- EXPANDED VIEWS (Dynamic per Active Mode)       -->
            <!-- ============================================== -->

            <!-- Category Switcher Pill Header (Appears at top of expanded view) -->
            <Grid x:Name="ExpandedContainer"
                  Opacity="0.0"
                  Visibility="Collapsed"
                  Margin="14,4,14,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Category Pills & Controls Header -->
                    <RowDefinition Height="*" />    <!-- Active View Area -->
                </Grid.RowDefinitions>

                <!-- Top Header Row -->
                <Grid Grid.Row="0" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Header Quick Actions (Toggle, Pin, Collapse) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StyleToggleButton"
                                Style="{StaticResource WinUI3IconButton}"
                                Padding="3"
                                ToolTip="Toggle Notch / Floating Capsule mode"
                                Click="StyleToggleButton_Click">
                            <ui:SymbolIcon Symbol="ShapeSubtract24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                        <Button x:Name="PinButton"
                                Style="{StaticResource WinUI3IconButton}"
                                Padding="3"
                                Margin="2,0,0,0"
                                ToolTip="Pin island expanded"
                                Click="PinButton_Click">
                            <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                        <Button x:Name="CollapseButton"
                                Style="{StaticResource WinUI3IconButton}"
                                Padding="3"
                                Margin="2,0,0,0"
                                ToolTip="Collapse island"
                                Click="CollapseButton_Click">
                            <ui:SymbolIcon Symbol="ChevronUp24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Active View Container (Switches based on active category) -->
                <Grid Grid.Row="1">

                    <!-- ============================================== -->
                    <!-- 1. MEDIA PLAYBACK VIEW (Image 1)               -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewMediaPlayback" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Artwork + Track Info + Prev/Play/Next (Matches Image 1) -->
                        <Grid Grid.Row="0" Margin="0,0,0,4" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Artwork Tile -->
                            <Border Grid.Column="0"
                                    Width="38" Height="38"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Image x:Name="ExpandedAlbumImage" Stretch="UniformToFill" />
                                    <Rectangle x:Name="ExpandedDefaultOrb" Fill="{DynamicResource AccentColorBrush}" />
                                    <ui:SymbolIcon x:Name="ExpandedOrbSymbol" Symbol="MusicNote224" FontSize="14" Foreground="{DynamicResource PlayButtonForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Title & Artist -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ExpandedTitleText"
                                           Text="rockstar"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ExpandedArtistText"
                                           Text="Post Malone"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,1,0,0" />
                            </StackPanel>

                            <!-- Playback controls cluster (Previous, Circular Play/Pause, Next) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PreviousButton" Style="{StaticResource WinUI3IconButton}" ToolTip="Previous" Margin="0,0,6,0" Click="PreviousButton_Click">
                                    <ui:SymbolIcon Symbol="Previous24" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Button>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource WinUI3PlayButton}" Width="32" Height="32" Margin="0,0,6,0" Click="PlayPauseButton_Click">
                                    <ui:SymbolIcon x:Name="PlayPauseIcon" Symbol="Pause24" FontSize="15" Foreground="{DynamicResource PlayButtonForegroundBrush}" />
                                </Button>
                                <Button x:Name="NextButton" Style="{StaticResource WinUI3IconButton}" ToolTip="Next" Click="NextButton_Click">
                                    <ui:SymbolIcon Symbol="Next24" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Scrubber Bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PositionText" Grid.Column="0" Text="1:15" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider x:Name="TrackSlider" Grid.Column="1" Style="{StaticResource WinUI3Slider}" Minimum="0" Maximum="100" Value="35" PreviewMouseDown="TrackSlider_PreviewMouseDown" PreviewMouseUp="TrackSlider_PreviewMouseUp" ValueChanged="TrackSlider_ValueChanged" />
                            <TextBlock x:Name="DurationText" Grid.Column="2" Text="3:40" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>

                        <!-- Bottom Volume Row -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ShuffleButton" Style="{StaticResource WinUI3IconButton}" ToolTip="Shuffle" Margin="0,0,4,0" Click="ShuffleButton_Click">
                                    <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                                <Button x:Name="RepeatButton" Style="{StaticResource WinUI3IconButton}" ToolTip="Repeat" Click="RepeatButton_Click">
                                    <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="VolumeButton" Style="{StaticResource WinUI3IconButton}" ToolTip="Mute" Margin="0,0,2,0" Click="VolumeButton_Click">
                                    <ui:SymbolIcon x:Name="VolumeIcon" Symbol="Speaker224" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                                <Slider x:Name="VolumeSlider" Style="{StaticResource WinUI3Slider}" Width="65" Minimum="0" Maximum="100" Value="75" ValueChanged="VolumeSlider_ValueChanged" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 2. CONNECTED DEVICES BATTERY (Image 2)         -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewDeviceBattery" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Glowing Green Device Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1A107C41" BorderBrush="#33107C41" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Headphones24" FontSize="20" Foreground="#107C41" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Device Name & Battery Pills -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="BatteryDeviceName" Text="AirPods Pro" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <!-- Left Earbud -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="8,2,8,2" Margin="0,0,6,0">
                                    <TextBlock Text="L  80%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <!-- Right Earbud -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="8,2,8,2" Margin="0,0,6,0">
                                    <TextBlock Text="R  78%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <!-- Case -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="8,2,8,2">
                                    <TextBlock Text="Case  100%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Green Check Badge -->
                        <Border Grid.Column="2" Width="26" Height="26" CornerRadius="13" Background="#107C41" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 3. APP NOTIFICATION / UPDATE (Image 3)         -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewAppNotification" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Orange Gauge Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#22FF8C00" BorderBrush="#44FF8C00" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Gauge24" FontSize="20" Foreground="#FF8C00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- App Update / Warning -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NotificationTitleText" Text="Claude — 82% used" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="NotificationSubtext" Text="5-hour limit almost reached — tap to view" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Chevron Arrow -->
                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 4. FOCUS TIMER MODE (Image 4 pill)             -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewFocusTimer" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Focus Icon -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#22D97706" BorderBrush="#44D97706" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="20" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Focus Session Active" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="FocusCountdownText" Text="24:50 remaining" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <Button x:Name="FocusToggleButton" Grid.Column="2" Content="Pause" Style="{StaticResource WinUI3IconButton}" Background="{DynamicResource SubtleHoverBrush}" Padding="12,5,12,5" Click="FocusToggleButton_Click" />
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 5. LIVE ACTIVITIES & TASKS (Image 4 build)      -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewLiveActivities" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Build / Task Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#220078D4" BorderBrush="#440078D4" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Code24" FontSize="20" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="build — Background Task" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Compiling WindowsLive release • 68% complete" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <ProgressBar Grid.Column="2" Width="70" Height="6" Value="68" Maximum="100" Foreground="{DynamicResource AccentColorBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 6. LIVE BRIGHTNESS & AUDIO LEVELS (Image 5)    -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewHardwareLevels" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Volume Level Bar (White capsule style matching Image 5) -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Symbol="Speaker224" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <ProgressBar x:Name="HardwareVolumeBar" Grid.Column="1" Height="14" Value="72" Maximum="100" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource CardBackgroundBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HardwareVolumeText" Grid.Column="2" Text="72%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Brightness Level Bar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Symbol="BrightnessHigh24" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <Slider x:Name="HardwareBrightnessSlider" Grid.Column="1" Style="{StaticResource WinUI3Slider}" Minimum="0" Maximum="100" Value="50" ValueChanged="HardwareBrightnessSlider_ValueChanged" />
                            <TextBlock x:Name="HardwareBrightnessText" Grid.Column="2" Text="50%" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 7. LIVE CLIPBOARD SHELF (Image 6)              -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewLiveClipboard" Visibility="Collapsed" VerticalAlignment="Center" Margin="4,8,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Purple Clipboard Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#228764B8" BorderBrush="#448764B8" BorderThickness="1.5" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="20" Foreground="#8764B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Copied to the shelf" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="ClipboardPreviewText" Text="https://notchy.dev — 3 items today" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 8. WINDOW SNAPPING CONTROLS (Item 8)           -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewWindowSnapping" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,8,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Snap Active Window" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" HorizontalAlignment="Center" />

                        <!-- Snapping Preset Buttons -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Left Half" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapLeft_Click" />
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Right Half" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapRight_Click" />
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Top Half" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapTop_Click" />
                            <Button Style="{StaticResource WinUI3IconButton}" Content="Maximize" Background="{DynamicResource CardBackgroundBrush}" Padding="10,5,10,5" Margin="4,0,4,0" Click="SnapMax_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- 9. TIMER SET WINDOW (Image 7)                  -->
                    <!-- ============================================== -->
                    <Grid x:Name="ViewTimerQuickSet" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,4,8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Search / Input Pill (Matches Image 7) -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="10,6,10,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="tim" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Grid.Column="1" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{DynamicResource SubtleHoverBrush}" CornerRadius="4" Padding="4,1,4,1">
                                    <TextBlock Text="esc" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Action Item 1: Start Focus Timer -->
                        <Button Grid.Row="1" Style="{StaticResource WinUI3IconButton}" HorizontalContentAlignment="Stretch" Padding="10,6,10,6" Margin="0,0,0,4" Background="{DynamicResource SubtleHoverBrush}" Click="StartFocusTimerPreset_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start a focus timer" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="25m" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Action Item 2: Quick Stopwatch / 15m Timer -->
                        <Button Grid.Row="2" Style="{StaticResource WinUI3IconButton}" HorizontalContentAlignment="Stretch" Padding="10,6,10,6" Background="Transparent" Click="Start15MinTimer_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Short Break Timer" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="5m" Grid.Column="1" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
