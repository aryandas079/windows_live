<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Dynamic Theme & Accent Resources (Updated at runtime by ThemeService) -->
    <SolidColorBrush x:Key="AccentColorBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="#0A0A0B" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#18181A" />
    <SolidColorBrush x:Key="PlayButtonBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PlayButtonForegroundBrush" Color="#121214" />
    <SolidColorBrush x:Key="CircleButtonBackgroundBrush" Color="#2A2A2E" />

    <!-- Backward compatibility alias -->
    <SolidColorBrush x:Key="AccentLimeBrush" Color="#0078D7" />

    <!-- WinUI 3 Circular Subtle Button (Prev / Next matching Dynamic Island style) -->
    <Style x:Key="WinUI3CircularSubtleButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource CircleButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CircleBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="16"
                            Width="32" Height="32">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CircleBorder" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CircleBorder" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WinUI 3 Icon Button Style -->
    <Style x:Key="WinUI3IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                            <Setter TargetName="RootBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.94" ScaleY="0.94" CenterX="14" CenterY="14" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WinUI 3 Primary Play/Pause Circle Button (Solid White in dark mode, Black in light mode) -->
    <Style x:Key="WinUI3PlayButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PlayButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PlayButtonForegroundBrush}" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CircleBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="19"
                            Width="38" Height="38">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CircleBorder" Property="Opacity" Value="0.9" />
                            <Setter TargetName="CircleBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#000000" BlurRadius="8" Opacity="0.3" ShadowDepth="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CircleBorder" Property="Opacity" Value="0.75" />
                            <Setter TargetName="CircleBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.92" ScaleY="0.92" CenterX="19" CenterY="19" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WinUI 3 Slider Style -->
    <Style x:Key="WinUI3Slider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Track Background -->
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource SubtleHoverBrush}" />
                        <!-- Track Progress -->
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentColorBrush}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="12" Height="12" CornerRadius="6"
                                                    Background="{DynamicResource AccentColorBrush}"
                                                    BorderBrush="{DynamicResource SurfaceDarkBrush}"
                                                    BorderThickness="2"
                                                    Cursor="Hand">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="4" Opacity="0.35" ShadowDepth="1" />
                                                </Border.Effect>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
